#!/usr/bin/env python3
import sys
import os
import glob
import argparse

from dcaf.analysis.multiples import MultiplesAnalyzer
from dcaf.analysis.formation import compute_formation_kinematics


def cmd_find_multiples(args):
    # expand globs in the order provided
    files = []
    for pat in args.inputs:
        files.extend(sorted(glob.glob(pat)))
    if not files:
        print("No input files matched.", file=sys.stderr)
        return 1

    analyzer = MultiplesAnalyzer(k=args.k, out_dir=args.out_dir, results_name=args.results)
    analyzer.process_files(files)
    print(f"Processed {len(files)} snapshots.")
    print(f"- results: {os.path.join(args.out_dir, args.results)}")
    print(f"- trees:   {os.path.join(args.out_dir, '<basename>_mult.npz')}")
    return 0

def cmd_local_kinematics(args):
    files = []
    for pat in args.inputs:
        files.extend(sorted(glob.glob(pat)))
    if not files:
        print("No input files matched.", file=sys.stderr)
        return 1

    compute_formation_kinematics(files, output_csv=args.out, file_format=args.format)

    print(f"Processed {len(files)} snapshots.")
    print(f"- results: {args.out}")
    return 0


def build_parser():
    p = argparse.ArgumentParser(
            description="D-CAF analysis: Characterization of star formation "
            "simulations for N-body modeling."
    )
    sub = p.add_subparsers(dest="cmd", required=True)

    # find_multiples
    pm = sub.add_parser("find_multiples", help="Find hierarchical multiples in snapshots")
    pm.add_argument("inputs", nargs="+", help="Snapshot file(s), glob patterns allowed (e.g., stars*.hdf5)")
    pm.add_argument("-k", type=int, default=20, help="KD-tree neighbors (default: 20)")
    pm.add_argument("--out-dir", default="multiples", help="Output folder (default: multiples)")
    pm.add_argument("--results", default="multiples.csv", help="Results filename inside out-dir (default: multiples.csv)")
    pm.set_defaults(func=cmd_find_multiples)

    plk = sub.add_parser("formation_kinematics", help="Formation kinematics for new stars")
    plk.add_argument("inputs", nargs="+", help="Snapshot file(s), glob patterns allowed (e.g., stars*)")
    plk.add_argument("--out", default="formation_kinematics.csv", help="Output CSV (default: formation_kinematics.csv)")
    plk.add_argument("--format", default="amuse", help="Snapshot format (default: amuse)")
    plk.set_defaults(func=cmd_local_kinematics)

    return p


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    parser = build_parser()
    args = parser.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
